<?xml version="1.0" encoding="UTF-8"?>
<!-- A100 corridor scenario. Inputs are exactly the files SUMO 1.27 resolves for
     the configuration used in the study (checked with save-configuration).
     The FCD/fragment scripts override begin/end on the command line. -->
<sumoConfiguration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/sumoConfiguration.xsd">
    <input>
        <net-file value="berlin.net.xml.gz"/>
        <route-files value="a100-east.rou.xml.gz"/>
        <additional-files value="berlin_bus_stops.add.xml,rsus.add.xml"/>
    </input>
    <time>
        <begin value="0"/>
        <end value="86400"/>
    </time>
    <processing>
        <route-steps value="200"/>
        <no-internal-links value="false"/>
        <ignore-junction-blocker value="20"/>
        <time-to-teleport value="120.0"/>
        <time-to-teleport.highways value="0"/>
        <eager-insert value="false"/>
    </processing>
    <random_number>
        <random value="false"/>
        <seed value="42"/>
    </random_number>
</sumoConfiguration>
